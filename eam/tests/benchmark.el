;;; benchmark.el -*- lexical-binding: t; -*-
(load (expand-file-name "support/eam-demo.el" (file-name-directory (or load-file-name buffer-file-name))) nil t)
(require 'eam)
(require 'json)
(defun ai-bench-snapshot (sessions)
  (let ((gc (garbage-collect)))
    `((rss_kib . ,(string-to-number (car (process-lines "ps" "-o" "rss=" "-p" (number-to-string (emacs-pid))))))
      (gc_live_estimate_bytes . ,(cl-loop for row in gc when (and (numberp (nth 1 row)) (numberp (nth 2 row))) sum (* (nth 1 row) (nth 2 row))))
      (buffer_characters . ,(cl-loop for s in sessions sum (with-current-buffer (eam-session-output s) (buffer-size))))
      (archive_bytes . ,(cl-loop for s in sessions sum (eam--size s))))))
(let ((eam-directory (make-temp-file "eam-bench-" t))
      results)
  (unwind-protect
      (progn
        (dolist (count '(1 4 12))
          (let* ((sessions (cl-loop repeat count collect (eam--create)))
                 (before (ai-bench-snapshot sessions)) warm after history extended times)
            (dotimes (i 1000)
              (dolist (s sessions)
                (let ((start (float-time)))
                  (eam--append s (eam--batch s))
                  (push (* 1000 (- (float-time) start)) times)))
              (when (= i 99) (setq warm (ai-bench-snapshot sessions))))
            (setq after (ai-bench-snapshot sessions) times (sort times #'<))
            (dotimes (_ 1000)
              (dolist (s sessions)
                (with-current-buffer (eam-session-output s)
                  (eam-history-previous-page)
                  (when (= 0 (car (eam-session-cursor s))) (eam-history-latest)))))
            (setq history (ai-bench-snapshot sessions))
            (when (= count 12)
              (dotimes (_ 4000)
                (dolist (s sessions)
                  (with-current-buffer (eam-session-output s)
                    (eam-history-previous-page)
                    (when (= 0 (car (eam-session-cursor s))) (eam-history-latest)))))
              (setq extended (ai-bench-snapshot sessions)))
            (push `((sessions . ,count) (batches_per_session . 1000)
                    (before . ,before) (after_100 . ,warm) (after_1000 . ,after)
                    (after_1000_history_reads . ,history)
                    (after_5000_history_reads . ,extended)
                    (batch_p95_ms . ,(nth (floor (* .95 (length times))) times))
                    (batch_max_ms . ,(car (last times)))) results)
            (dolist (s sessions)
              (with-current-buffer (eam-session-output s) (eam-detach)))))
        ;; Real timers, but batch mode has no GUI redisplay or keyboard/IME events.
        (let* ((sessions (cl-loop repeat 12 collect (eam--create)))
               (last (float-time)) (max-lag 0.0) (beats 0)
               (heartbeat (run-at-time .01 .01 (lambda ()
                                                (let ((now (float-time)))
                                                  (setq max-lag (max max-lag (- now last .01)) last now)
                                                  (cl-incf beats)))))
               (deadline (+ (float-time) 3)))
          (dolist (s sessions)
            (with-current-buffer (eam-session-input s)
              (insert "한글 입력과 긴 로그 테스트") (eam-demo-send)))
          (while (< (float-time) deadline) (sleep-for .005))
          (cancel-timer heartbeat)
          (push `((timer_sessions . 12) (duration_seconds . 3) (heartbeat_count . ,beats)
                  (max_heartbeat_lag_ms . ,(* 1000 max-lag))) results)
          (dolist (s sessions)
            (with-current-buffer (eam-session-output s) (eam-detach))))
        (princ (json-encode `((emacs . ,emacs-version) (system . ,system-configuration)
                              (results . ,(vconcat (nreverse results)))))))
    (delete-directory eam-directory t)))
