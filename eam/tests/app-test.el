(ert-deftest eam-resume-arguments-and-invalid-id ()
  (let ((eam-terminal--sessions nil) (eam-cli-notifications nil) calls)
    (cl-letf (((symbol-function 'eam--executable) #'identity)
              ((symbol-function 'eam-persistent--start)
               (lambda (name dir args)
                 (push (list name nil args dir) calls)
                 (eam-terminal--session))))
      (should-error (eam-resume "Codex" "/tmp" "--last") :type 'user-error)
      (should-not calls)
      (eam-resume "Claude" "/tmp" "")
      (should (equal (nth 2 (car calls)) '("--resume")))
      (eam-resume "Codex" "/tmp" "01a07f90-db19-7910-87cd-76a13e97d3f4")
      (should (equal (nth 2 (car calls)) '("resume" "01a07f90-db19-7910-87cd-76a13e97d3f4"))))))
(ert-deftest eam-draft-keeps-parent-suffix ()
  "Opening same-project drafts in reverse order preserves terminal identity."
  (let* ((name "*Codex terminal: /tmp/project*")
         (first (eam-terminal--session :name "Codex" :directory "/tmp/project/"
                                           :output (generate-new-buffer name)))
         (second (eam-terminal--session :name "Codex" :directory "/tmp/project/"
                                            :output (generate-new-buffer name))))
    (unwind-protect
        (progn
          (should (equal (buffer-name (eam-terminal--ensure-draft second))
                         "*Codex draft: /tmp/project*<2>"))
          (should (equal (buffer-name (eam-terminal--ensure-draft first))
                         "*Codex draft: /tmp/project*"))
          (with-current-buffer (eam-terminal-input second)
            (should (eq eam-terminal--current second))))
      (dolist (s (list first second))
        (dolist (b (list (eam-terminal-input s) (eam-terminal-output s)))
          (when (buffer-live-p b) (kill-buffer b)))))))
(ert-deftest eam-app-entry-and-keyboard-commands ()
