(require 'ert)
(require 'eam-app)

(ert-deftest eam-session-query-deadline-and-events ()
  "Slow Git jobs must allow timers, obey concurrency, and leave no jobs alive."
  (let ((original (symbol-function 'make-process))
        (eam-session-query-timeout 0.35)
        (ticks 0) jobs timer result)
    (unwind-protect
        (progn
          (setq timer (run-at-time 0.01 0.01 (lambda () (cl-incf ticks))))
          (cl-letf (((symbol-function 'make-process)
                     (lambda (&rest args)
                       (let* ((default-directory "/tmp/")
                              (process
                              (apply original
                                     (plist-put args :command
                                                (list "/bin/sleep" "10")))))
                         (push process jobs)
                         process))))
            (setq result (eam-app--branches
                          (cl-loop for n below 20 collect (format "/tmp/../tmp/%s/.." n)))))
          (should (> ticks 0))
          (should (= (length jobs) 8))
          (maphash (lambda (_ value) (should (equal value "unverified"))) result)
          (should (= (hash-table-count result) 20))
          (should-not (cl-some #'process-live-p jobs)))
      (when timer (cancel-timer timer))
      (dolist (process jobs) (when (process-live-p process) (delete-process process))))))

(ert-deftest eam-session-query-quit-cleanup ()
  (let ((original (symbol-function 'make-process)) jobs)
    (cl-letf (((symbol-function 'make-process)
               (lambda (&rest args)
                 (let ((process (apply original
                                       (plist-put args :command '("/bin/sleep" "10")))))
                   (push process jobs) process)))
              ((symbol-function 'accept-process-output)
               (lambda (&rest _) (signal 'quit nil))))
      (should (eq 'cancelled
                  (condition-case nil (eam-app--branches '("/tmp/"))
                    (quit 'cancelled)))))
    (should (= (length jobs) 1))
    (should-not (cl-some #'process-live-p jobs))))

(ert-deftest eam-session-query-output-bound ()
  (let ((original (symbol-function 'make-process)) jobs)
    (cl-letf (((symbol-function 'make-process)
               (lambda (&rest args)
                 (let ((process
                        (apply original
                               (plist-put args :command
                                          (list (or (getenv "EAM_NATIVE_FIXTURE")
                                                          (error "Run scripts/test-native.sh")) "flood")))))
                   (push process jobs) process))))
      (should (equal (eam-app--branch "/tmp/") "—")))
    (should (process-get (car jobs) 'overflow))
    (should (<= (length (process-get (car jobs) 'branch-output)) 4096))
    (should-not (cl-some #'process-live-p jobs))))

(ert-deftest eam-session-query-concurrent-output ()
  "Every completed pipe must be drained before reading its branch output."
  (let ((original (symbol-function 'make-process))
        (eam-session-query-timeout 5.0)
        (directories (cl-loop for n below 24 collect (format "/fixture/%d" n))))
    (cl-letf (((symbol-function 'make-process)
               (lambda (&rest args)
                 (let ((default-directory "/tmp/"))
                   (apply original
                          (plist-put args :command '("/usr/bin/printf" "feature/한글\\n")))))))
      (let ((result (eam-app--branches directories)))
        (should (= (hash-table-count result) 24))
        (maphash (lambda (_ value) (should (equal value "feature/한글"))) result)))))

(ert-deftest eam-sessions-detached-selection-only-attaches ()
  (let ((eam-terminal--sessions nil) attached)
    (cl-letf (((symbol-function 'eam-app--live-inventory)
               (lambda (&optional _observe) '((sessions . (((session . "/tmp/persistent/session")
                                          (provider . "Codex") (directory . "/tmp/project")
                                          (attached_clients . 0)))))))
              ((symbol-function 'eam-attach) (lambda (directory) (setq attached directory)))
              ((symbol-function 'eam-new) (lambda (&rest _) (ert-fail "Restarted CLI"))))
      (save-window-excursion
        (eam-sessions)
        (should-not attached)
        (should (derived-mode-p 'eam-session-list-mode))
        (eam-session-list--open)
        (should (equal attached "/tmp/persistent/session"))))))

(ert-deftest eam-session-branch-local-and-unavailable ()
  (let ((directory (make-temp-file "eam-branch-" t)))
    (unwind-protect
        (let ((default-directory (file-name-as-directory directory)))
          (should (equal (eam-app--branch directory) "—"))
          (should (eq 0 (process-file "git" nil nil nil "init" "--quiet")))
          (should (eq 0 (process-file "git" nil nil nil "symbolic-ref" "HEAD"
                                     "refs/heads/feature/한글")))
          (should (equal (eam-app--branch directory) "feature/한글"))
          (should (equal (eam-app--branch (concat directory "/missing")) "—"))
          (cl-letf (((symbol-function 'process-file)
                     (lambda (&rest _) (ert-fail "Contacted remote host"))))
            (should (equal (eam-app--branch "/ssh:example:/project/") "—"))))
      (delete-directory directory t))))

