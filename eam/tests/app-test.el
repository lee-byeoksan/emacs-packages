(ert-deftest eam-minimal-command-completion-and-no-start-screen ()
  (should-not (fboundp 'eam))
  (should (eq (lookup-key eam-command-map (kbd "a")) 'eam-attach))
  (let (visible)
    (mapatoms (lambda (symbol)
                (when (and (string-prefix-p "eam-" (symbol-name symbol))
                           (commandp symbol)
                           (command-completion-default-include-p symbol (current-buffer)))
                  (push (symbol-name symbol) visible))))
    (should (equal (sort visible #'string<)
                   '("eam-attach" "eam-caffeine-mode" "eam-detach" "eam-detach-all" "eam-draft" "eam-edit-input" "eam-help" "eam-history" "eam-history-open" "eam-keys-mode" "eam-native-build" "eam-new" "eam-next-session" "eam-note" "eam-notifications" "eam-paste" "eam-persist" "eam-previous-session" "eam-prompt" "eam-quick" "eam-quit" "eam-rename" "eam-resume" "eam-review-selection" "eam-sessions" "eam-status" "eam-usage"))))
  (eam-keys-mode 1)
  (should-not (get-buffer "*EAM*"))
  (should-not (key-binding (kbd "C-c a RET")))
  (should-not (fboundp 'eam-enter)))

