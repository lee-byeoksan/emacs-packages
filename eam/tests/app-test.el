(ert-deftest eam-session-state-is-process-state ()
  (let* ((process (make-process :name "ai-state-test" :command '("/bin/sh" "-c" "exit 7")
                                :buffer nil :noquery t))
         (session (eam-terminal--session :process process)))
    (unwind-protect
        (progn
          (while (process-live-p process) (accept-process-output process 0.05))
          (should (equal (eam-app--process-state session) "exit(7)"))
          (setf (eam-terminal-error session) "disk error")
          (should (equal (eam-app--process-state session)
                         "exit(7); recording error")))
      (delete-process process))))

(ert-deftest eam-app-resources-independent-of-records ()
  "A relocated record directory must not redirect the manual or project root."
  (let ((eam-directory "/tmp/separate-ai-records/")
        (default-directory "/tmp/") opened)
    (unwind-protect
        (progn
          (eam-keys-mode 1)
          (should (equal default-directory "/tmp/"))
          (cl-letf (((symbol-function 'view-file) (lambda (path) (setq opened path))))
            (call-interactively (key-binding (kbd "C-c a ?"))))
          (should (file-exists-p opened))
          (should (equal opened (expand-file-name "docs/user-guide.md" eam--resource-directory))))
      (when (get-buffer "*EAM*") (kill-buffer "*EAM*")))))
(ert-deftest eam-help-read-only-and-keyboard-return ()
  (let* ((root (make-temp-file "eai-help-" t))
         (eam--resource-directory root)
         (configuration (current-window-configuration))
         buffer)
    (unwind-protect
        (progn
          (make-directory (expand-file-name "docs" root))
          (with-temp-file (expand-file-name "docs/user-guide.md" root)
            (insert "한글 사용 안내\n"))
          (eam-help)
          (setq buffer (current-buffer))
          (should buffer-read-only)
          (should view-mode)
          (should-error (insert "accidental edit") :type 'buffer-read-only)
          (call-interactively (key-binding (kbd "q")))
          (should-not (eq (window-buffer) buffer)))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (set-window-configuration configuration)
      (delete-directory root t))))
