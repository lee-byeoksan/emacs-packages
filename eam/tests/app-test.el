(ert-deftest eam-keys-disable-restores-bindings ()
  (let ((before eam-keys-mode)
        (global-map (copy-keymap global-map)))
    (unwind-protect
        (progn
          (eam-keys-mode -1)
          (define-key global-map (kbd "C-c a") #'ignore)
          (eam-keys-mode 1)
          (should (eq (key-binding (kbd "C-c a b")) #'eam-draft))
          (eam-keys-mode -1)
          (should (eq (key-binding (kbd "C-c a")) #'ignore)))
      (eam-keys-mode (if before 1 -1)))))
(ert-deftest eam-app-project-selection-and-cancel ()
  (let ((use-dialog-box t) (provider "Claude") calls)
    (cl-letf (((symbol-function 'read-string) (lambda (&rest _) ""))
              ((symbol-function 'completing-read)
               (lambda (_prompt collection _predicate require-match &rest _)
                 (should (equal collection '("Claude" "Codex")))
                 (should require-match)
                 provider))
              ((symbol-function 'read-directory-name)
               (lambda (&rest _) (should-not use-dialog-box) "/tmp/한글 프로젝트/"))
              ((symbol-function 'file-directory-p) (lambda (_path) t))
              ((symbol-function 'eam-terminal-start-provider)
               (lambda (p d &optional _name) (push (cons p d) calls))))
      (call-interactively #'eam-new)
      (setq provider "codex")
      (call-interactively #'eam-new)
      (should (equal calls '(("Codex" . "/tmp/한글 프로젝트/") ("Claude" . "/tmp/한글 프로젝트/")))))
    (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (signal 'quit nil)))
              ((symbol-function 'read-directory-name) (lambda (&rest _) (ert-fail "Project after provider cancel")))
              ((symbol-function 'eam-terminal-start-provider) (lambda (&rest _) (ert-fail "Started after cancel"))))
      (should (eq (condition-case nil (call-interactively #'eam-new) (quit 'cancelled)) 'cancelled)))
    (should use-dialog-box)
    (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Claude"))
              ((symbol-function 'read-directory-name)
               (lambda (&rest _) (should-not use-dialog-box) "/tmp/"))
              ((symbol-function 'read-string) (lambda (prompt &rest _)
                                               (should (string-prefix-p "Session name" prompt)) ""))
              ((symbol-function 'eam-persistent--start)
               (lambda (&rest _) (push 'resumed calls) (eam-terminal--session))))
      (call-interactively #'eam-resume)
      (should (eq (car calls) 'resumed)))
    (should use-dialog-box)))

