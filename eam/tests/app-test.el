(ert-deftest eam-detach-all-snapshots-registry-and-continues-after-errors ()
  (let* ((a (generate-new-buffer " *eam-detach-all-a*"))
         (b (generate-new-buffer " *eam-detach-all-b*"))
         (other (generate-new-buffer " *eam-unrelated*"))
         (first (eam-terminal--session :output a))
         (second (eam-terminal--session :output b))
         (eam-terminal--sessions (list first second))
         calls)
    (unwind-protect
        (cl-letf (((symbol-function 'eam-detach)
                   (lambda ()
                     (push (current-buffer) calls)
                     (if (eq (current-buffer) a)
                         (progn (setq eam-terminal--sessions nil) (error "Fixture failure"))
                       (kill-buffer (current-buffer))))))
          (with-current-buffer other (should-error (eam-detach-all) :type 'user-error))
          (should (equal (nreverse calls) (list a b)))
          (should (buffer-live-p other))
          (should-not (buffer-live-p b))
          (should (= 0 (eam-detach-all))))
      (mapc (lambda (buffer) (when (buffer-live-p buffer) (kill-buffer buffer)))
            (list a b other)))))
