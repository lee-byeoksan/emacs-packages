;;; native-resume.el --- Resume only an explicitly selected proof conversation -*- lexical-binding: t; -*-
(require 'eam-app)
(require 'json)
(let* ((provider (getenv "EMACS_AI_NATIVE_PROVIDER"))
       (id (getenv "EMACS_AI_NATIVE_ID"))
       (root (file-name-as-directory (getenv "EMACS_AI_NATIVE_ROOT")))
       (eam-directory root)
       (path (expand-file-name "session" root))
       session screen restored blocked started)
  (unless (and (member provider '("Codex" "Claude"))
               (string-match-p "\\`[0-9a-f-]+\\'" id))
    (error "Explicit provider and conversation ID required"))
  (when (file-exists-p root) (error "Refuse existing probe directory"))
  (unless (string-match-p "package-profile-0.8.5" (symbol-file 'eam-attach 'defun))
    (error "Use installed 0.8.5"))
  (make-directory root t)
  (unwind-protect
      (progn
        (eam-persistent--call
         "start" `((session . ,path) (provider . ,provider)
                   (executable . ,(eam--executable (downcase provider)))
                   (args . ,(vconcat (eam-notifications-cli-args provider)
                                     (list (if (equal provider "Codex") "resume" "--resume") id)))
                   (directory . ,(expand-file-name default-directory))))
        (setq started t)
        (let ((deadline (+ (float-time) 3)))
          (while (and (< (float-time) deadline)
                      (not (file-exists-p (expand-file-name "events.jsonl" path))))
            (accept-process-output nil .05)))
        (setq session (eam-attach path))
        (let ((deadline (+ (float-time) 25)))
          (while (and (< (float-time) deadline) (not restored) (not blocked))
            (accept-process-output nil .1)
            (setq screen
                  (with-current-buffer (eam-terminal-output session)
                    (set-window-buffer (selected-window) (current-buffer))
                    (ghostel--redraw-now (current-buffer) t)
                    (buffer-string)))
            (setq blocked (string-match-p "[Tt]rust this\\|[Tt]rust.*folder\\|[Ss]ign in\\|[Ll]og in" screen)
                  restored (and (string-match-p (format "PERSISTENT_REAL_%s" provider) screen)
                                (string-match-p "^[•⏺] DONE[ \t]*$" screen)))))
        (with-temp-file (expand-file-name "screen.txt" root) (insert (or screen ""))))
    (when (and session (buffer-live-p (eam-terminal-output session)))
      (with-current-buffer (eam-terminal-output session) (eam-detach)))
    (when started (eam-persistent--call "stop" `((session . ,path))))
    (when (and (boundp 'server-process) (processp server-process)
               (process-live-p server-process))
      (server-force-delete)))
  (let ((result `((provider . ,provider) (conversation_id . ,id)
                  (prior_request_and_response_visible . ,(if restored t :json-false))
                  (trust_or_login_seen . ,(if blocked t :json-false))
                  (new_requests_submitted . 0) (terminal_input_sent . :json-false)
                  (gui_test . :json-false) (owned_server_stopped . t)
                  (route . "native resume arguments -> persistent manager -> installed Ghostel attach"))))
    (with-temp-file (expand-file-name "result.json" root) (insert (json-encode result)))
    (message "%s" (json-encode result))
    (unless restored (error "Prior conversation was not verified on screen"))))
