;;; -*- lexical-binding: t; -*-
(require 'ert)
(require 'eam-app)
(load (expand-file-name "events.el" (file-name-directory load-file-name)) nil t)
(defun eai-test-event (seq)
  (concat (json-encode `((version . 1) (seq . ,seq) (end_offset . ,seq)
                         (title . "한글") (body . ,(format "event-%d" seq)))) "\n"))
(defmacro eai-with-events (&rest body)
  `(let ((file (make-temp-file "eai-events-"))
         (buffer (generate-new-buffer " *eai-events*"))
         (eam-notifications--entries nil))
     (unwind-protect (progn ,@body)
       (kill-buffer buffer) (delete-file file))))
(ert-deftest eai-events-partial-repeat-and-session-attribution ()
  (eai-with-events
   (let* ((line (eai-test-event 1)) (reader (eai-event-reader-open file buffer)))
     (write-region (substring line 0 30) nil file t 'silent)
     (eai-event-reader-poll reader)
     (should-not eam-notifications--entries)
     (write-region (substring line 30) nil file t 'silent)
     (eai-event-reader-poll reader)
     (should (= 1 (length eam-notifications--entries)))
     (should (eq buffer (eam-notice-buffer (car eam-notifications--entries))))
     (should (eq reader (eai-event-reader-open file buffer)))
     (dotimes (_ 3) (eai-event-reader-poll reader))
     (should (= 1 (eam-notice-count (car eam-notifications--entries)))))))
(ert-deftest eai-events-latest-tail-and-bounded-poll ()
  (eai-with-events
   (with-temp-file file (dotimes (i 3000) (insert (eai-test-event (1+ i)))))
   (let* ((size (file-attribute-size (file-attributes file)))
          (reader (eai-event-reader-open file buffer))
          (start (eai-event-reader-offset reader)))
     (should (> start 0))
     (should (<= (- size start) 65536))
     (eai-event-reader-poll reader)
     (should (= 3000 (eai-event-reader-sequence reader)))
     (should (<= (length eam-notifications--entries) 100))
     (should (< (length (eai-event-reader-pending reader)) 32768)))))
(ert-deftest eai-events-replaced-and-truncated-stop ()
  (dolist (replace '(nil t))
    (eai-with-events
     (write-region (eai-test-event 1) nil file nil 'silent)
     (let ((reader (eai-event-reader-open file buffer)))
       (eai-event-reader-poll reader)
       (if replace
           (let ((replacement (make-temp-file "eai-replacement-")))
             (rename-file replacement file t))
         (write-region "" nil file nil 'silent))
       (should-error (eai-event-reader-poll reader))
       (should (eai-event-reader-failed reader))
       (should-error (eai-event-reader-poll reader))))))
(ert-deftest eai-events-oversized-invalid-stop ()
  (dolist (bad (list (make-string 40000 ?x) "{\"version\":2}\n" "not-json\n"))
    (eai-with-events
     (let ((reader (eai-event-reader-open file buffer)))
       (write-region bad nil file t 'silent)
       (should-error (eai-event-reader-poll reader))
       (should-not eam-notifications--entries)
       (should (eai-event-reader-failed reader))))))
