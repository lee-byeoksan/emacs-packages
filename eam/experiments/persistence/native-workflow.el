;;; native-workflow.el --- Explicit real AI file-write/notification probe -*- lexical-binding: t; -*-
(require 'eam-app)
(require 'json)
(let* ((provider (getenv "EMACS_AI_NATIVE_PROVIDER"))
       (root (file-name-as-directory (getenv "EMACS_AI_NATIVE_ROOT")))
       (eam-directory root)
       (target (expand-file-name "proof.txt" root))
       (expected (format "PERSISTENT_REAL_%s\n" provider))
       (eam-notifications--entries nil)
       session path ready submitted permission completion screen)
  (when (file-exists-p root) (error "Refuse an existing probe directory"))
  (make-directory root t)
  (unless (string-match-p "package-profile-0.8.4" (symbol-file 'eam-new 'defun))
    (error "Use installed 0.8.4"))
  (cl-labels
      ((screen ()
         (with-current-buffer (eam-terminal-output session)
           (set-window-buffer (selected-window) (current-buffer))
           (ghostel--redraw-now (current-buffer) t)
           (buffer-string)))
       (matches ()
         (and (file-exists-p target) (<= (file-attribute-size (file-attributes target)) 1024)
              (equal expected (with-temp-buffer (insert-file-contents target) (buffer-string)))))
       (notices ()
         (mapcar (lambda (entry) `((title . ,(eam-notice-title entry))
                                   (body . ,(eam-notice-body entry)))) eam-notifications--entries)))
    (unwind-protect
        (progn
          (setq session (eam-new provider default-directory)
                path eam-terminal-persistent-directory)
          (let ((deadline (+ (float-time) 15)))
            (while (and (not ready) (not permission) (< (float-time) deadline))
              (accept-process-output nil .1)
              (setq screen (screen))
              (setq permission (string-match-p "[Tt]rust this\\|[Tt]rust.*folder\\|[Ss]ign in\\|[Ll]og in" screen))
              (setq ready (and (not permission)
                               (if (equal provider "Codex")
                                   (and (string-match-p "OpenAI Codex" screen) (string-match-p "› " screen))
                                 (and (string-match-p "Claude Code" screen) (string-match-p "❯" screen)))))))
          (with-temp-file (expand-file-name "before.txt" root) (insert screen))
          (when ready
            (setq eam-notifications--entries nil)
            (with-current-buffer (eam-terminal-output session)
              (ghostel-paste-string
               (format "Create the file %s containing exactly PERSISTENT_REAL_%s followed by a newline. Change no other files. Then reply DONE."
                       target provider)))
            (accept-process-output nil .2)
            (with-current-buffer (eam-terminal-output session) (eam-terminal-key "return"))
            (setq submitted t)
            (let ((deadline (+ (float-time) 90)))
              (while (and (< (float-time) deadline) (not permission) (not completion))
                (accept-process-output nil .1)
                (setq screen (screen))
                (setq permission
                      (or (cl-find "PermissionRequest" eam-notifications--entries
                                   :key #'eam-notice-body :test #'equal)
                          (string-match-p "Would you like to run\\|Do you want to.*proceed\\|Allow this action" screen)))
                (setq completion
                      (and (matches)
                           (if (equal provider "Claude")
                               (cl-find "Stop" eam-notifications--entries :key #'eam-notice-body :test #'equal)
                             eam-notifications--entries))))))
          (with-temp-file (expand-file-name "screen.txt" root) (insert (or screen "")))
          (let ((result `((provider . ,provider) (submitted_requests . ,(if submitted 1 0))
                          (ready . ,(if ready t :json-false))
                          (file_matches . ,(if (matches) t :json-false))
                          (completion_event . ,(if completion t :json-false))
                          (approval_or_login_seen . ,(if permission t :json-false))
                          (events . ,(vconcat (notices))) (gui_test . :json-false))))
            (with-temp-file (expand-file-name "result.json" root) (insert (json-encode result)))
            (message "%s" (json-encode result))))
      (when session
        (when (buffer-live-p (eam-terminal-output session))
          (with-current-buffer (eam-terminal-output session) (eam-detach))))
      (when path (eam-persistent--call "stop" `((session . ,path))))
      (when (and (boundp 'server-process) (processp server-process)
                 (process-live-p server-process))
        (server-force-delete)))))
