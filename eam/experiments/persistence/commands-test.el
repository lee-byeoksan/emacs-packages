;;; -*- lexical-binding: t; -*-

;; Historical retired-backend fixture, not part of the current test suite.
(require 'ert)
(load (expand-file-name "commands.el" (file-name-directory load-file-name)) nil t)
(ert-deftest eai-persistent-stop-requires-confirmed-result ()
  (let* ((path (expand-file-name "/tmp/eai-stop-result-test"))
         (eam-persistent--readers (make-hash-table :test #'equal))
         (reader (list 'existing-reader))
         (result '((state . "unavailable"))))
    (puthash path reader eam-persistent--readers)
    (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
              ((symbol-function 'eam-persistent--call)
               (lambda (&rest _) result)))
      (should-error (eam-quit path) :type 'user-error)
      (should (eq reader (gethash path eam-persistent--readers)))
      (setq result '((state . "stopped")))
      (eam-quit path)
      (should-not (gethash path eam-persistent--readers)))))
(defun eai-command-wait (predicate)
  (let ((deadline (+ (float-time) 5)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil .05))
    (should (funcall predicate))))
(ert-deftest eai-persistent-commands-attach-detach-reattach ()
  (let* ((root (make-temp-file "eai-command-" t))
         (eam-directory (file-name-as-directory root))
         (path (expand-file-name "session" root))
         (eam-notifications--entries nil)
         (eam-persistent--readers (make-hash-table :test #'equal))
         info session first-timer)
    (unwind-protect
        (progn
          (setq info (eam-persistent--call
                      "start" `((raw_recording . t) (session . ,path) (provider . "Fake")
                                (executable . ,(executable-find "python3"))
                                (args . ["-c" "import os,time; os.write(1,b'READY\\r\\n\\x1b]9;notice\\x07'); time.sleep(30)"])
                                (directory . ,root))))
          (eai-command-wait (lambda () (file-exists-p (alist-get 'events info))))
          (let ((buffers (buffer-list)) (timers (copy-sequence timer-list))
                (window-buffer-before (window-buffer)))
            (cl-letf (((symbol-function 'eai-event-reader-open)
                       (lambda (&rest _) (error "Injected event journal failure"))))
              (should-error (eam-attach path))
)
            (should (eq (window-buffer) window-buffer-before))
            (eai-command-wait (lambda () (not (cl-set-difference timer-list timers))))
            (should-not (cl-find-if
                         (lambda (b) (and (not (memq b buffers))
                                          (buffer-local-value 'eam-terminal--current b)))
                         (buffer-list)))
            (should-not (gethash path eam-persistent--readers))
            (eai-command-wait
             (lambda ()
               (let ((state (alist-get 'status (eam-persistent--call "inspect" `((session . ,path))))))
                 (and (equal (alist-get 'state state) "running")
                      (zerop (alist-get 'attached_clients state)))))))
          (setq session (eam-attach path))
          (eai-command-wait
           (lambda ()
             (with-current-buffer (eam-terminal-output session)
               (set-window-buffer (selected-window) (current-buffer))
               (ghostel--redraw-now (current-buffer) t)
               (string-match-p "READY" (buffer-string)))))
          (should-error (eam-attach path))
          ;; Force a stale preflight response: the manager's lease must still
          ;; reject the second display and the Emacs call must report failure.
          (let* ((original (symbol-function 'eam-persistent--call))
                 (stale (funcall original "inspect" `((session . ,path))))
                 (previous-window (window-buffer)))
            (setf (alist-get 'attached_clients (alist-get 'status stale)) 0)
            (cl-letf (((symbol-function 'eam-persistent--call)
                       (lambda (action request)
                         (if (equal action "inspect") stale (funcall original action request)))))
              (should-error (eam-attach path)))
            (should (eq previous-window (window-buffer)))
            (should (process-live-p (eam-terminal-process session))))
          (eai-command-wait (lambda () (= 1 (length eam-notifications--entries))))
          (with-current-buffer (eam-terminal-output session)
            (setq first-timer eam-persistent--timer)
            (should (eq buffer-undo-list t))
            (eam-detach))
          (should-not (memq first-timer timer-list))
          (eai-command-wait
           (lambda () (zerop (alist-get 'attached_clients
                            (alist-get 'status (eam-persistent--call "inspect" `((session . ,path))))))))
          (let ((before (with-temp-buffer
                          (insert-file-contents-literally (alist-get 'archive info)) (buffer-string))))
            (setq session (eam-attach path))
            (eai-command-wait
             (lambda ()
               (with-current-buffer (eam-terminal-output session)
                 (set-window-buffer (selected-window) (current-buffer))
                 (ghostel--redraw-now (current-buffer) t)
                 (string-match-p "READY" (buffer-string)))))
            (accept-process-output nil .3)
            (should (= 1 (length eam-notifications--entries)))
            (should (= 1 (eam-notice-count (car eam-notifications--entries))))
            (should (eq (eam-notice-buffer (car eam-notifications--entries))
                        (eam-terminal-output session)))
            (with-temp-buffer
              (insert-file-contents-literally (alist-get 'archive info))
              (should (equal before (buffer-string)))))
          (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
            (eam-quit path))
          (should (file-exists-p (alist-get 'archive info))))
      (when session
        (when (buffer-live-p (eam-terminal-output session))
          (with-current-buffer (eam-terminal-output session) (eam-detach))))
      (when info
        (eam-persistent--call "stop" `((session . ,path)))
        (delete-directory (alist-get 'runtime info) t))
      (server-force-delete)
      (delete-directory root t))))
